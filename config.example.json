{
  "http": {
    "bind": "0.0.0.0",
    "port": 8080,
    "publicBaseUrl": "https://music.example.com",
    "trustedProxies": ["127.0.0.1/32", "::1/128"]
  },
  "data": {
    "dir": "./data"
  },
  "output": {
    "profile": "720p30",
    "videoBitrateKbps": 3000
  },
  "ingest": {
    "maxUploadBytes": "4 GiB",
    "maxDurationSeconds": 1800,
    "quickPreset": "veryfast",
    "qualityPreset": "slow"
  },
  "overlay": {
    "workers": 1,
    "cacheMaxBytes": "20 GiB"
  }
}
