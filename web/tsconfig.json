{
  // Compiled by `npm run build` during `mvn package` (frontend-maven-plugin).
  // Plain ES modules for the browser, no bundler: relative imports must name the
  // compiled file, e.g. `import { x } from "./util.js";`.
  "compilerOptions": {
    // Browser baseline: iOS 15 / Safari 15.0 (see docs/architecture.md#browser-baseline).
    // target ES2022 keeps class fields, private `#` members and top-level await
    // native (all fine in Safari 15.0). lib ES2021 makes tsc reject the ES2022+
    // library calls 15.0 lacks (`.at()`, `Object.hasOwn`, `findLast`). What tsc
    // can't catch (class static blocks, `structuredClone` from the DOM lib) is
    // checked in the compiled output by WebBuildTest.
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "rootDir": "src",
    // Lands in the jar as /web/js/; static assets from web/static/ go to /web/.
    "outDir": "../target/classes/web/js",
    "sourceMap": true,
    "inlineSources": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
